{% extends 'base.html.twig' %}

{% block title %}Edit Post{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 760px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Edit Post</h1>
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('post_show', {id: post.id}) }}">Cancel</a>
    </div>

    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.content) }}
        {% if post.image %}
            <div class="mb-3">
                <label class="form-label">Current Image</label><br>
                <img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="Current image" style="max-height: 150px;" class="rounded">
            </div>
        {% endif %}
        {{ form_row(form.imageFile) }}
        <button class="btn btn-primary" type="submit">Save Changes</button>
    {{ form_end(form) }}
</div>
{% endblock %}
