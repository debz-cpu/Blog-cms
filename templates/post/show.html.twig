{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
<div class="container py-4">
    <a class="btn btn-link px-0 mb-3" href="{{ path('post_index') }}">Back to posts</a>

    <article class="card shadow-sm mb-4">
        {% if post.image %}
            <img src="{{ asset('uploads/posts/' ~ post.image) }}" class="card-img-top" alt="{{ post.title }}">
        {% endif %}
        <div class="card-body">
            <h1 class="h3">{{ post.title }}</h1>
            <p class="text-muted small">By {{ post.user.email }} on {{ post.createdAt|date('Y-m-d H:i') }}</p>
            <div class="mt-3">{{ post.content|nl2br }}</div>
        </div>
    </article>

    <section class="mb-4">
        <h2 class="h5">Comments</h2>

        {% if comments is empty %}
            <p class="text-muted">No approved comments yet.</p>
        {% else %}
            <div class="list-group">
                {% for comment in comments %}
                    <div class="list-group-item">
                        <p class="mb-1">{{ comment.content|nl2br }}</p>
                        <small class="text-muted">{{ comment.user.email }} on {{ comment.createdAt|date('Y-m-d H:i') }}</small>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section>
        <h2 class="h5">Leave a Comment</h2>
        {% if app.user %}
            {{ form_start(form) }}
                {{ form_row(form.content) }}
                <button class="btn btn-primary" type="submit">Submit</button>
            {{ form_end(form) }}
            <p class="small text-muted mt-2">Comments require admin approval before they appear publicly.</p>
        {% else %}
            <p class="mb-0">Please <a href="{{ path('app_login') }}">sign in</a> to comment.</p>
        {% endif %}
    </section>
</div>
{% endblock %}
